# Solr AI Doctor Configuration

# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./solr_doctor.db

# LLM Configuration
# Modes: LIVE_LLM | EXPLICIT_MOCK
LLM_MODE=EXPLICIT_MOCK
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=15

# Anomaly Detection Thresholds (Configurable)
SOLR_QTIME_WARN_MS=1000
SOLR_QTIME_CRIT_MS=5000
SOLR_ERROR_BURST_COUNT=3
GC_PAUSE_WARN_MS=1000
GC_PAUSE_CRIT_MS=3000
HEAP_USAGE_WARN_PCT=80.0
HEAP_USAGE_CRIT_PCT=92.0

# Correlation Configuration
CORRELATION_WINDOW_SECONDS=90
SAME_NODE_BOOST=true
TOPOLOGY_SHARD_CORRELATION=true
